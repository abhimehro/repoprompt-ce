# Environment template for pr-recap (Agent-Native PR Recap CLI)
# Copy to .env.pr-recap or reference directly via 1Password / Proton Pass

# 1. Direct environment variable (fallback or CI)
# LINEAR_API_KEY="lin_api_..."

# 2. 1Password Secret Reference (Primary - used with op read / op run)
OP_LINEAR_API_KEY="op://Personal/LINEAR_API_KEY/credential"

# 3. Proton Pass Reference (Fallback - used with pass-cli)
PROTON_PASS_VAULT="Personal"
PROTON_PASS_ITEM="LINEAR_API_KEY"
PROTON_PASS_FIELD="Secret"
